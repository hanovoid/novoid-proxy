          },
          "limit": { "context": 1000000, "output": 65536 },
          "variants": [
            { "id": "default" },
            { "id": "xhigh", "headers": { "x-novoid-tier": "xhigh" } },
            { "id": "high", "headers": { "x-novoid-tier": "high" } },
            { "id": "medium", "headers": { "x-novoid-tier": "medium" } },
            { "id": "low", "headers": { "x-novoid-tier": "low" } }
          ]
        },
        "novoid-hydrogen": {
          "name": "Novoid Hydrogen",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text", "image"],
            "output": ["text"],
