            { "id": "tiered-high", "headers": { "x-novoid-tier": "tiered-high" } },
            { "id": "sonar", "headers": { "x-novoid-tier": "sonar" } }
          ]
        },
        "novoid-carbon": {
          "name": "Novoid Carbon",
          "capabilities": {
            "tools": true,
